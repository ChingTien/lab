{
  "name": "value-dialogue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node server/index.js",
    "dev:worker": "wrangler dev --local",
    "db:migrate:local": "wrangler d1 migrations apply value-dialogue --local",
    "db:migrate:remote": "wrangler d1 migrations apply value-dialogue --remote",
    "deploy:worker": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.1.0",
    "wrangler": "^4.131.2"
  }
}
